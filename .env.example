# IQFeed local connection (requires IQConnect running on this machine)
IQFEED_HOST=127.0.0.1
IQFEED_PORT_LEVEL1=5009
IQFEED_PORT_LOOKUP=9100 # set to 9400 if your install exposes lookup on that port
IQFEED_L1_PORT=5009
IQFEED_LOOKUP_PORT=9100 # alias used by legacy scripts; keep in sync
IQFEED_PORT_ADMIN=9300
IQFEED_PORT_NEWS=9200
IQFEED_LOGIN=your_iqfeed_login
IQFEED_USERNAME=your_iqfeed_login
IQFEED_PASSWORD=your_iqfeed_password
IQFEED_PRODUCT_ID=YOUR_PRODUCT_ID  # alias: IQFEED_PRODUCT
IQFEED_VERSION=6.2.1.29
IQFEED_LOOKUP_TIMEOUT_SECONDS=45
# Comma-separated list of preferred IQFeed news feeds (The Fly is default)
IQFEED_NEWS_SOURCES=THEFLY

# Polygon / Massive data
POLYGON_API_KEY=your_polygon_api_key
POLYGON_WS_PROBE_SECONDS=2.5
ZERO_DTE_DISABLE_POLYGON=0
ZERO_DTE_USE_MASSIVE=0
MASSIVE_BASE_URL=https://api.massive.com
MASSIVE_API_KEY=
MASSIVE_WS_SAME_AS_POLYGON=1
SYMBOLS=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA,VIX

# Alpha Vantage (optional)
ALPHA_VANTAGE_API_KEY=

# OpenAI (optional for LLM tooling)
OPENAI_API_KEY=
OPENAI_PROJECT=

# Discord notifications (optional)
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_WEBHOOK_URL=
DISCORD_MONITOR_WEBHOOK=
DISCORD_MORNING_BRIEF_WEBHOOK=
DISCORD_MORNING_WEBHOOK=
VIX_ALERTS_ENABLED=0
VIX_ALERT_CHANNEL_ID=
VIX_ALERT_CHECK_SEC=60
VIX_ALERT_ABS_MOVE=1.0
VIX_ALERT_PCT_MOVE=5.0
VIX_GATING_ENABLED=0
VIX_MAX_REGIME=ELEVATED VOL
VIX_HARD_BLOCK_LEVEL=30
VIX_SOFT_BLOCK_LEVEL=25
MONDAY_PLAYBOOK_ENABLED=0
MONDAY_PLAYBOOK_TIME_ET=09:25
MONDAY_PLAYBOOK_CHANNEL_ID=
MONDAY_PLAYBOOK_SYMBOLS=SPY,QQQ,IWM

# Morning brief automation
MORNING_BRIEF_ENABLED=0
MORNING_BRIEF_CHANNEL_ID=
MORNING_BRIEF_TIME_ET=08:00
MORNING_BRIEF_DAYS=MON,TUE,WED,THU,FRI
BOT_ALERT_CHANNEL_ID=

# Earnings calendar
EARNINGS_PROVIDER=earningsapi
EARNINGS_API_KEY=
EARNINGS_WATCHLIST=SPY,QQQ,IWM,AAPL,MSFT,NVDA,AMZN,META,GOOGL,TSLA

# TNT Intelligence Expansion (earnings + news + daily outlook)
# Note: run_live.ps1 loads .env/.env.local into the worker processes.
TNT_AUTOMATION_ENABLED=0

# Enable the Massive→Benzinga news poller worker in run_live.ps1
TNT_NEWS_POLLER_ENABLED=0

# Earnings posts (Expected + Results)
EARNINGS_AUTOPOST_ENABLED=0
TNT_EARNINGS_DAILY_TIME_ET=18:00

EARNINGS_RESULTS_AUTOPOST_ENABLED=0
TNT_EARNINGS_RESULTS_TIMES_ET=11:00,18:10

# Daily Market Outlook
DAILY_OUTLOOK_ENABLED=0
DAILY_OUTLOOK_TIME_ET=08:45
DAILY_OUTLOOK_CHANNEL_ID=0
DAILY_OUTLOOK_SYMBOLS=SPY,QQQ,IWM

# Headlines: filter to material-only catalysts by default
TNT_HEADLINES_MATERIAL_ONLY=1

# Alerts: append a single cached headline if it occurred recently
TNT_ALERT_NEWS_CONTEXT_WINDOW_MIN=120

# Earnings Results: "Why it moved" headline window
TNT_EARNINGS_WHY_MOVED_WINDOW_HOURS=48

# Macro events configuration
MACRO_EVENTS_FILE=data/macro_events.csv

# News API (optional)
NEWS_API_KEY=

# Data source priority comma-separated
DATA_SOURCE_PRIORITY=polygon,iqfeed

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Pipeline defaults
DEFAULT_TIMEOUT_SECONDS=60
MORNING_REPORT_TOTAL_TIMEOUT_SECONDS=240
CANDIDATE_MIN_CONFIDENCE=0.5
GATING_STRICTNESS=loose
