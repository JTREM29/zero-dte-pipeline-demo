# Environment variable template for ZeroDTE pipeline

# Market Data Providers
POLYGON_API_KEY=replace_me
IQFEED_USERNAME=replace_me
IQFEED_PASSWORD=replace_me

# IQFeed socket endpoints (desktop client must be running)
IQFEED_HOST=127.0.0.1
IQFEED_PORT_LEVEL1=5009
IQFEED_PORT_ADMIN=5009
# If you use distinct admin port, change above and update code.

# OpenAI
OPENAI_API_KEY=replace_me

# Runtime
LOG_LEVEL=INFO
DATA_DIR=data
LOG_DIR=logs
