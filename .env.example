# IQFeed Credentials
IQFEED_LOGIN=your_iqfeed_login
IQFEED_PASSWORD=your_iqfeed_password
IQFEED_PRODUCT_ID=your_product_id

# Polygon.io API
POLYGON_API_KEY=your_polygon_api_key

# Alpha Vantage API
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# OpenAI API (optional, for AI-based analysis)
OPENAI_API_KEY=your_openai_api_key

# News API (optional)
NEWS_API_KEY=your_news_api_key

# Data source priority (comma-separated: iqfeed,polygon,alpha_vantage)
DATA_SOURCE_PRIORITY=iqfeed,polygon,alpha_vantage

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Pipeline settings
DEFAULT_TIMEOUT_SECONDS=30
CANDIDATE_MIN_CONFIDENCE=0.5
GATING_STRICTNESS=moderate
